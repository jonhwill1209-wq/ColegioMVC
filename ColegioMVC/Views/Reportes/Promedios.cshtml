@model IEnumerable<ColegioMVC.Models.PromedioViewModel>

@{
    ViewData["Title"] = "Promedios";
}

<h1 class="fw-bold mb-4">
    <i class="bi bi-bar-chart-fill"></i>
    Promedio de Notas por Alumno
</h1>

<div class="card shadow p-4 mb-4">

    <table class="table table-hover align-middle">

        <thead class="table-dark">

            <tr>
                <th>Alumno</th>
                <th>Promedio</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Alumno</td>

                    <td>
                        @item.Promedio.ToString("0.00")
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<div class="card shadow p-4">

    <h2 class="fw-bold mb-4">

        <i class="bi bi-graph-up-arrow"></i>
        Promedios Generales

    </h2>

    <canvas id="graficaPromedios"></canvas>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    var ctx = document.getElementById('graficaPromedios');

    var alumnos = [

    @foreach (var item in Model)
    {
        @: '@item.Alumno',
    }

    ];

    var promedios = [

    @foreach (var item in Model)
    {
        @: @item.Promedio,
    }

    ];

    new Chart(ctx, {

    type: 'bar',

    data: {

    labels: alumnos,

    datasets: [{

                label: 'Promedio',

                data: promedios,

                backgroundColor: [
                '#ff6384',
                '#36a2eb',
                '#ffce56',
                '#4bc0c0',
                '#9966ff',
                '#ff9f40',
                '#8dd17e',
                '#e76f51',
                '#2a9d8f',
                '#264653'
                ],

                borderColor: [
                '#ff6384',
                '#36a2eb',
                '#ffce56',
                '#4bc0c0',
                '#9966ff',
                '#ff9f40',
                '#8dd17e',
                '#e76f51',
                '#2a9d8f',
                '#264653'
                ],

                borderRadius: 10,

                borderWidth: 1

        }]

    },

                options: {

                responsive: true,

                plugins: {

                legend: {
                display: true
                }

                },

                 scales: {

                 y: {

                 beginAtZero: true,
                  max: 10

                }

             }

         }

    });

</script>