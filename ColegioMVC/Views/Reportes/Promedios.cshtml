@model IEnumerable<ColegioMVC.Models.PromedioViewModel>

<h1>Promedio de Notas por Alumno</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Alumno</th>
            <th>Promedio</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Alumno</td>
                <td>@item.Promedio.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<hr />
<h2>Gráfica de Promedios</h2>
<canvas id="graficaPromedios"></canvas>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('graficaPromedios');

        var alumnos = [
            @foreach (var item in Model)
            {
                @: '@item.Alumno',
            }
        ];

            var promedios = [
            @foreach (var item in Model)
            {
                @: @item.Promedio,
            }
        ];

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: alumnos,
                datasets: [
                    {
                    label: 'Promedio',
                    data: promedios,
                    borderWidth: 1
                    }
                ]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    max: 10
                   }
                }
             }
        });
    </script>