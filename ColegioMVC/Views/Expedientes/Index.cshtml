@model IEnumerable<ColegioMVC.Models.Expediente>

@{
    ViewData["Title"] = "Expedientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">
        <i class="bi bi-folder2-open"></i>
        Gestión de Expedientes
    </h1>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Nuevo Expediente
    </a>

</div>

<div class="card shadow p-4">

    <div class="row mb-4">

        <div class="col-md-4">
            <input type="text"
                   id="buscarExpediente"
                   class="form-control"
                   placeholder="Buscar alumno o materia..." />
        </div>

    </div>

    <table class="table table-hover align-middle"
           id="tablaExpedientes">

        <thead class="table-dark">

            <tr>
                <th>Alumno</th>
                <th>Materia</th>
                <th>Nota Final</th>
                <th>Observaciones</th>
                <th width="280">Acciones</th>
            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Alumno.Nombre
                        @item.Alumno.Apellido
                    </td>

                    <td>
                        @item.Materia.NombreMateria
                    </td>

                    <td>
                        @item.NotaFinal
                    </td>

                    <td>
                        @item.Observaciones
                    </td>

                    <td>

                        <div class="d-flex gap-2">

                            <a asp-action="Edit"
                                   asp-route-id="@item.ExpedienteId"
                                   class="btn btn-warning btn-sm">

                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <a asp-action="Details"
                                   asp-route-id="@item.ExpedienteId"
                                   class="btn btn-info btn-sm text-white">

                                <i class="bi bi-eye"></i>
                            </a>

                            <a asp-action="Delete"
                                   asp-route-id="@item.ExpedienteId"
                                   class="btn btn-danger btn-sm">

                                <i class="bi bi-trash"></i>
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<script>

    const buscarExpediente =
        document.getElementById('buscarExpediente');

    buscarExpediente.addEventListener('keyup', function () {

        let filtro = this.value.toLowerCase();

        let filas = document.querySelectorAll(
            '#tablaExpedientes tbody tr'
        );

        filas.forEach(fila => {

            let texto = fila.textContent.toLowerCase();

            fila.style.display =
                texto.includes(filtro)
                    ? ''
                    : 'none';
        });
    });

</script>