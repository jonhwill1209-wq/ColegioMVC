@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="text-center">

    <h1 class="display-4 fw-bold">
        Sistema Académico San José
    </h1>

    <p class="lead">
        Gestión de alumnos, materias y expedientes académicos.
    </p>

</div>

<div class="row mt-5">

    <div class="col-md-3">
        <div class="card shadow">
            <div class="card-body text-center">
                <h3>Alumnos</h3>

                <a asp-controller="Alumnos" asp-action="Index"
                       class="btn btn-primary">
                    Ir
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow">
            <div class="card-body text-center">
                <h3>Materias</h3>

                <a asp-controller="Materias" asp-action="Index"
                       class="btn btn-success">
                    Ir
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow">
            <div class="card-body text-center">
                <h3>Expedientes</h3>

                <a asp-controller="Expedientes" asp-action="Index"
                       class="btn btn-warning">
                    Ir
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow">
            <div class="card-body text-center">
                <h3>Promedios</h3>

                <a asp-controller="Reportes" asp-action="Promedios"
                       class="btn btn-danger">
                    Ir
                </a>
            </div>
        </div>
    </div>

</div>